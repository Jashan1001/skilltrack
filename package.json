{
  "name": "skilltrack",
  "version": "1.0.0",
  "private": true,
  "engines": { "node": ">=22.13.0" },
  "scripts": {
    "dev:client": "npm --prefix client run dev",
    "dev:server": "npm --prefix server run dev",
    "dev:engine": "npm --prefix execution-engine run dev",
    "build:client": "npm --prefix client run build",
    "build:server": "npm --prefix server run build",
    "build:engine": "npm --prefix execution-engine run build",
    "typecheck:client": "npm --prefix client run typecheck",
    "build": "npm run typecheck:client && npm run build:client && npm run build:server && npm run build:engine",
    "lint": "npm --prefix client run lint",
    "seed": "npm --prefix server run seed"
  }
}
